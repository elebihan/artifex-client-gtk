<?xml version="1.0" encoding="utf-8"?>
<schemalist>
  <schema path="/com/elebihan/artifex-client-gtk/" id="@app-id@" gettext-domain="@gettext-package@">
    <key name="window-width" type="i">
      <default>800</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>600</default>
      <summary>Window height</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
    <key name="recent-urls" type="as">
        <default>[]</default>
      <summary>Recent URLs</summary>
      <description>This is the list of URLs to servers recently used</description>
    </key>
  </schema>
  <schema path="/com/elebihan/artifex-client-gtk/" id="@app-id@.connection" gettext-domain="@gettext-package@">
    <key name="auth-root-cert-uri" type="s">
      <default>""</default>
      <summary>Root certificate URI</summary>
      <description>URI of the root certificate to use for connection authentication</description>
    </key>
    <key name="auth-client-cert-uri" type="s">
      <default>""</default>
      <summary>Client certificate URI</summary>
      <description>URI of the client certificate to use for connection authentication</description>
    </key>
    <key name="auth-client-key-uri" type="s">
      <default>""</default>
      <summary>Client key URI</summary>
      <description>URI of the client key to use for connection authentication</description>
    </key>
    <key name="auth-server-alt-name" type="s">
      <default>""</default>
      <summary>Server alternate name</summary>
      <description>Server alternate name to use for TLS certificate authentication</description>
    </key>
  </schema>
</schemalist>
